{
  "easycom": {
    "custom": {
      "^u--(.*)": "uview-plus/components/u-$1/u-$1.vue",
      "^up-(.*)": "uview-plus/components/u-$1/u-$1.vue",
      "^u-([^-].*)": "uview-plus/components/u-$1/u-$1.vue",
      "^(?!z-paging-refresh|z-paging-load-more)z-paging(.*)": "z-paging/components/z-paging$1/z-paging$1.vue"
    }
  },
  "pages": [
    {
      "path": "pages/home/index",
      "style": {
        "navigationBarTitleText": "怡宝家园",
        "navigationStyle": "custom"
      }
    },
    {
      "path": "pages/login/index",
      "style": {
        "navigationBarTitleText": "登录授权",
        "backgroundColor": "#f3f5f7"
      }
    },
    {
      "path": "pages/series/index",
      "style": {
        "navigationBarTitleText": ""
      }
    },
    {
      "path": "pages/series/list",
      "style": {
        "navigationBarTitleText": "怡宝家园",
        "navigationStyle": "custom"
      }
    },
    {
      "path": "pages/series/detail",
      "style": {
        "navigationBarTitleText": "系列详情"
      }
    },
    {
      "path": "pages/series/ml/index",
      "style": {
        "navigationBarTitleText": "1元畅饮赢大奖"
      }
    },
    {
      "path": "pages/series/zbqr/index",
      "style": {
        "navigationBarTitleText": "1元畅饮赢大奖"
      }
    },
    {
      "path": "pages/series/zwcs/index",
      "style": {
        "navigationBarTitleText": "1元畅饮赢大奖"
      }
    },
    {
      "path": "pages/profile/index",
      "style": {
        "navigationBarTitleText": "个人信息",
        "backgroundColor": "#f3f4f5"
      }
    },
    {
      "path": "pages/shop/index",
      "style": {
        "navigationBarTitleText": "兑奖点"
      }
    },
    {
      "path": "pages/shop/feedback",
      "style": {
        "navigationBarTitleText": "问题反馈"
      }
    },
    {
      "path": "pages/prize/index",
      "style": {
        "navigationBarTitleText": "我的奖品"
      }
    },
    {
      "path": "pages/prize/redeem-info",
      "style": {
        "navigationBarTitleText": "兑奖信息"
      }
    }
  ],
  "subPackages": [
    {
      "root": "pages/common",
      "pages": [
        {
          "path": "webview/index",
          "style": {
            "navigationBarTitleText": ""
          }
        },
        {
          "path": "404/index",
          "style": {
            "navigationBarTitleText": "404",
            "navigationStyle": "custom"
          }
        },
        {
          "path": "demo/index",
          "style": {
            "navigationBarTitleText": "demo示例"
          }
        },
        {
          "path": "demo/list",
          "style": {
            "navigationBarTitleText": "demo列表",
            "enablePullDownRefresh": true
          }
        }
      ]
    }
  ],
  "preloadRule": {
    "pages/home/index": {
      "network": "all",
      "packages": ["pages/common"]
    }
  },
  "globalStyle": {
    "navigationBarTextStyle": "black",
    "navigationBarTitleText": "畅饮怡刻",
    "navigationBarBackgroundColor": "#ffffff",
    "backgroundColor": "#ffffff"
  }
}
